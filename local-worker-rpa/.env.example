# ========================
# WORKER LOCAL (.env)
# ========================
# Copie para .env na máquina Windows do cliente e preencha

# Identidade
WORKER_ID=worker-cliente-01
WORKER_API_KEY=chave-compartilhada-com-o-worker-local-troque

# API Central (Railway)
API_WS_URL=wss://auto-adm.up.railway.app/ws/worker
API_BASE_URL=https://auto-adm.up.railway.app

# ERP SSPlus
ERP_EXECUTABLE_PATH=C:\SSPlus\SSPlus.exe
ERP_WINDOW_TITLE=SSPlus
ERP_STARTUP_TIMEOUT=30
ERP_ACTION_TIMEOUT=10
ERP_BACKEND=win32

# Retry RPA
RPA_MAX_RETRIES=3
RPA_RETRY_WAIT_MIN=2.0
RPA_RETRY_WAIT_MAX=8.0

# Armazenamento local
TEMP_DIR=C:\auto-adm\temp
STATE_DB_PATH=C:\auto-adm\worker_state.db
LOG_DIR=C:\auto-adm\logs
LOG_LEVEL=INFO

# Reconexão WebSocket
WS_RECONNECT_INITIAL_WAIT=2.0
WS_RECONNECT_MAX_WAIT=60.0
WS_RECONNECT_MAX_ATTEMPTS=0
