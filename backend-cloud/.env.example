# ========================
# BACKEND CLOUD (.env)
# ========================
# Copie para .env e preencha os valores reais

# Segurança
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-chars
WORKER_API_KEY=chave-compartilhada-com-o-worker-local-troque

# Banco de Dados
DATABASE_URL=postgresql+asyncpg://auto_adm:auto_adm_dev_pass@localhost:5432/auto_adm
DB_ECHO_SQL=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Ambiente
ENVIRONMENT=development
DEBUG=true

# CORS (separado por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Anexos (S3 / Cloudflare R2)
ATTACHMENT_STORAGE_URL=https://seu-bucket.r2.cloudflarestorage.com
MAX_ATTACHMENT_SIZE_MB=10
